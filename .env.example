POSTGRES_DB=neuro_notes_plugins
POSTGRES_USER=neuro_notes_plugins
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://neuro_notes_plugins:change-me@postgres:5432/neuro_notes_plugins
REDIS_URL=redis://redis:6379
# Compose maps these two values to Nuxt runtime config automatically.
NUXT_BACKEND_BASE_URL=http://host.docker.internal:5001
NUXT_GITHUB_TOKEN=
NUXT_SESSION_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
NUXT_PUBLIC_SITE_URL=http://localhost:3000
APP_PORT=3000
